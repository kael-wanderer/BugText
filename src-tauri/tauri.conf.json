{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BugText",
  "version": "0.3.5",
  "identifier": "com.kael.bugtext",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "BugText",
        "width": 1100,
        "height": 740,
        "minWidth": 640,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: preview:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https: http://localhost:* http://127.0.0.1:* ws://localhost:* data: blob:; frame-src 'self' preview: blob:; media-src 'self' data: blob:; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "macOS": {
      "bundleVersion": "252"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "txt"],
        "contentTypes": [
          "net.daringfireball.markdown",
          "public.plain-text"
        ],
        "name": "Markdown and Text Document",
        "role": "Editor",
        "rank": "Default"
      },
      {
        "ext": ["html", "htm"],
        "contentTypes": ["public.html"],
        "name": "HTML Document",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["pdf"],
        "contentTypes": ["com.adobe.pdf"],
        "name": "PDF Document",
        "role": "Viewer",
        "rank": "Default"
      }
    ]
  }
}
